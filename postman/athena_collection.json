{
  "info": {
    "name": "Athena Backend",
    "_postman_id": "abcd1234-5678-90ab-cdef-1234567890ab",
    "description": "Endpoints for the Athena cycle-synced workout API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"sport\": \"Soccer\",\n  \"experienceLevel\": \"Beginner\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('returns token', () => {",
              "    pm.expect(res).to.have.property('token');",
              "    pm.environment.set('authToken', res.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
