        }
      ]
    },
    {
      "name": "Get Athlete Profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/athlete/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "athlete", "me"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get('authToken')) {",
              "    postman.setNextRequest('Login');",
              "} else {",
              "    const token = pm.environment.get('authToken');",
              "    pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + token });",
              "    pm.request.headers.add({ key: 'Cookie', value: 'authToken=' + token });",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('athlete exists', () => pm.expect(res).to.have.property('athlete'));",
              "pm.test('has cycle predictions', () => {",
              "    pm.expect(res).to.have.property('predictedNextPeriodStart');",
              "    pm.expect(res).to.have.property('currentCycleDay');",
              "})"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
