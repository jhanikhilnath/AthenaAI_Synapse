        "body": {
          "mode": "raw",
          "raw": "{\n  \"age\": 25,\n  \"weight\": 65,\n  \"height\": 170,\n  \"mood\": \"Happy\",\n  \"symptoms\": \"None\",\n  \"sleep_hours\": 8,\n  \"stress_level\": 2\n}"
        },
        "url": {
