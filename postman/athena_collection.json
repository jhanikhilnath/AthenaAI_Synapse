          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('returns athlete object', () => pm.expect(res).to.have.property('athlete'));",
              "pm.test('added entry property', () => pm.expect(res).to.have.property('added'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Generate Workout (needs cycle info)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/workout/generate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "workout", "generate"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get('authToken')) {",
              "    postman.setNextRequest('Login');",
              "} else {",
              "    const token = pm.environment.get('authToken');",
              "    pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + token });",
              "    pm.request.headers.add({ key: 'Cookie', value: 'authToken=' + token });",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('should require cycle info', () => pm.response.to.have.status(400));",
              "pm.test('error mentions cycle information', () => {",
              "    const res = pm.response.json();",
              "    pm.expect(res.error).to.include('Cycle information');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Log Bleeding Day(s)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dates\": [\"2026-02-20\", \"2026-02-21\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/periods/bleeding",
          "host": ["{{baseUrl}}"],
          "path": ["api", "periods", "bleeding"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get('authToken')) {",
              "    postman.setNextRequest('Login');",
              "} else {",
              "    const token = pm.environment.get('authToken');",
              "    pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + token });",
              "    pm.request.headers.add({ key: 'Cookie', value: 'authToken=' + token });",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('cycle stored', () => pm.expect(res).to.have.property('updatedCycle'));",
              "pm.test('cycle may remain open', () => {",
              "    const c = res.updatedCycle;",
              "    pm.expect(c).to.have.property('start');",
              "    pm.expect(c).to.not.have.property('end');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get Cycle Info",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/periods",
          "host": ["{{baseUrl}}"],
          "path": ["api", "periods"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get('authToken')) {",
              "    postman.setNextRequest('Login');",
              "} else {",
              "    const token = pm.environment.get('authToken');",
              "    pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + token });",
              "    pm.request.headers.add({ key: 'Cookie', value: 'authToken=' + token });",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('contains history', () => pm.expect(res).to.have.property('cycleHistory'));",
              "pm.test('bleeding days included', () => {",
              "    const last = res.cycleHistory.slice(-1)[0] || {};",
              "    pm.expect(last).to.have.property('bleedingDates');",
              "});",
              "pm.test('prediction fields either present or null', () => {",
              "    pm.expect(res).to.have.property('averageCycleLength');",
              "    pm.expect(res).to.have.property('predictedNextPeriodStart');",
              "});",
              "pm.test('phase info maybe included', () => {",
              "    pm.expect(res).to.have.property('currentPhase');",
              "    pm.expect(res).to.have.property('physiologicalContext');",
              "    // if a cycle day exists we should get non-null strings",
              "    if (res.currentCycleDay != null) {",
              "        pm.expect(res.currentPhase).to.be.a('string').and.not.empty;",
              "        pm.expect(res.physiologicalContext).to.be.a('string').and.not.empty;",
              "    }",
              "});",
              "pm.test('local biology maybe included', () => {",
              "    pm.expect(res).to.have.property('localBiology');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
